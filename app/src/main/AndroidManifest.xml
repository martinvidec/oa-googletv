<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: Leanback erforderlich, kein Touchscreen -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Spracheingabe: Mikrofon wird zur Laufzeit angefragt. RECORD_AUDIO impliziert sonst
         android.hardware.microphone als Pflicht und filtert TVs ohne eingebautes Mikrofon aus. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Hermes-Gateway: Anfragen senden und vorher prüfen, ob überhaupt ein Netzwerk da ist. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Paket-Sichtbarkeit (API 30+): ohne diesen Eintrag meldet
         SpeechRecognizer.isRecognitionAvailable() immer false. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: Das Hermes-Gateway läuft typischerweise im Heimnetz ohne TLS (http://).
         Backup-Regeln: Das Gateway-Token wird nicht mitgesichert. -->
    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OaGoogleTv"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateHidden|adjustResize" />
    </application>

</manifest>
