<?xml version="1.0" encoding="utf-8"?>
<!-- Backup ab API 31: Das Hermes-Token (SharedPreferencesSettingsStore) weder in die Cloud noch aufs neue Gerät. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hermes_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hermes_settings.xml" />
    </device-transfer>
</data-extraction-rules>
