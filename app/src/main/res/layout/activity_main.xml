<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oa_background">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="32dp"
        android:paddingEnd="64dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/welcome"
                android:textColor="@android:color/white"
                android:textSize="32sp" />

            <Button
                android:id="@+id/voice_button"
                style="@style/Widget.OaGoogleTv.TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:nextFocusRight="@+id/settings_button"
                android:text="@string/voice_start">

                <requestFocus />
            </Button>

            <Button
                android:id="@id/settings_button"
                style="@style/Widget.OaGoogleTv.TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:nextFocusLeft="@id/voice_button"
                android:text="@string/settings_open" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/voice_hint"
            android:textColor="@color/oa_text_secondary"
            android:textSize="16sp" />

        <!-- Chat-Verlauf: Zeilen sind fokussierbar, damit der Verlauf per D-Pad durchblättert werden kann. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/chat_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxWidth="720dp"
                android:text="@string/chat_empty"
                android:textColor="@color/oa_text_secondary"
                android:textSize="22sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/chat_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/chat_sending"
            android:textColor="@color/oa_text_secondary"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/chat_error_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chat_error"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chat_error_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <Button
                android:id="@+id/chat_error_retry"
                style="@style/Widget.OaGoogleTv.TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/chat_action_retry" />

            <Button
                android:id="@+id/chat_error_settings"
                style="@style/Widget.OaGoogleTv.TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/voice_action_settings" />

            <Button
                android:id="@+id/chat_error_dismiss"
                style="@style/Widget.OaGoogleTv.TvButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/chat_action_dismiss" />
        </LinearLayout>
    </LinearLayout>

    <!-- Voice-Overlay im Leanback-Stil: abgedunkelter Hintergrund, Speech-Orb, Live-Transkript. -->
    <FrameLayout
        android:id="@+id/voice_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oa_overlay_scrim"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <androidx.leanback.widget.SpeechOrbView
                android:id="@+id/voice_orb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/voice_orb_description"
                android:focusable="true"
                android:nextFocusDown="@+id/voice_action" />

            <TextView
                android:id="@+id/voice_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:maxWidth="720dp"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/voice_transcript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:maxWidth="720dp"
                android:textColor="@color/oa_text_secondary"
                android:textSize="30sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/voice_action"
                    style="@style/Widget.OaGoogleTv.TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:nextFocusUp="@id/voice_orb"
                    android:nextFocusRight="@+id/voice_close" />

                <Button
                    android:id="@+id/voice_close"
                    style="@style/Widget.OaGoogleTv.TvButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nextFocusLeft="@id/voice_action"
                    android:nextFocusUp="@id/voice_orb"
                    android:text="@string/voice_action_close" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
